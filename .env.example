# Copy to backend/.env for local development. In Vercel, set these in Project → Settings → Environment Variables.
# Neon adds DATABASE_URL / DATABASE_URL_UNPOOLED automatically through the Vercel integration.

ENVIRONMENT=development            # development | preview | production
DATABASE_URL=sqlite:///./proppros.db   # Neon: postgresql+psycopg://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=             # Neon direct URL (used by Alembic migrations)
JWT_SECRET=                        # openssl rand -hex 32  (required in production)
COOKIE_SECURE=false                # true in production
FRONTEND_URL=http://localhost:5173 # https://your-domain in production (used in email links)
CRON_SECRET=                       # random string; Vercel Cron sends it as a Bearer token

# Email: SMTP (e.g. Gmail + app password) wins over Resend; neither → emails are only logged.
SMTP_HOST=                         # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                         # you@gmail.com
SMTP_PASSWORD=                     # Google app password (Security → App passwords)
RESEND_API_KEY=
EMAIL_FROM=Proppros <noreply@yourdomain.com>

BLOB_READ_WRITE_TOKEN=             # Vercel Blob token; blank (and no BLOB_STORE_ID) → files stored in backend/.uploads
BLOB_STORE_ID=                     # alternative to the token when Vercel uses OIDC auth
BLOB_ACCESS=private                # must match the Blob store: private | public
# Online rent payments (Stripe Connect). Blank → online payments are hidden.
STRIPE_SECRET_KEY=                 # sk_test_… (test mode) or sk_live_…
STRIPE_WEBHOOK_SECRET=             # whsec_… from the webhook endpoint for /api/stripe/webhook
# Proppros subscriptions (Stripe Billing). Off → everyone gets unlimited use and no plan limits apply.
BILLING_ENABLED=false
STRIPE_PRICE_PRO=                  # price_… : recurring, per unit, monthly
STRIPE_PRICE_BUSINESS=             # price_…
# Platform admin (/admin) and feedback
SUPERADMIN_EMAILS=                 # comma-separated emails of Proppros staff
FEEDBACK_NOTIFY_EMAIL=             # optional: where new in-app feedback is emailed
# Google sign-in. Blank → button hidden. Redirect URI: <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=            # blank → in-memory rate limiting (dev only)
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
